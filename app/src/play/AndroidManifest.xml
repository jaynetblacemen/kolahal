<?xml version="1.0" encoding="utf-8"?>
<!--
  The play build type, for Google Play: the app without what Play's policy rules out, or would
  want declarations, videos and consent screens for.
  - No accessibility service: Play doesn't count a launcher as an accessibility tool. No
    double-tap lock, no `lock`.
  - No notification listener: Play wants consent screens for it. No notifications in the log, no
    `notifs`, no media controls.
  - No call log: Play allows it only to phone, SMS and assistant apps. No calls in the log, no `calls`.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.READ_CALL_LOG" tools:node="remove" />

    <application>
        <service
            android:name=".gesture.LockService"
            tools:node="remove" />
        <service
            android:name=".notifications.KolahalNotificationListener"
            tools:node="remove" />
    </application>
</manifest>
