<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ backup rules. Settings (shared prefs) are backed up; the databases are not:
    kolahal.db holds the terminal log (which can contain other apps' notification text), script
    key-value data and the notification mirror; feeds.db is just a re-fetchable cache.
    "logs" prefs belong to the terminal log too.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="kolahal.db" />
        <exclude domain="database" path="kolahal.db-journal" />
        <exclude domain="database" path="kolahal.db-wal" />
        <exclude domain="database" path="kolahal.db-shm" />
        <exclude domain="database" path="feeds.db" />
        <exclude domain="database" path="feeds.db-journal" />
        <exclude domain="database" path="feeds.db-wal" />
        <exclude domain="database" path="feeds.db-shm" />
        <exclude domain="sharedpref" path="logs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="kolahal.db" />
        <exclude domain="database" path="kolahal.db-journal" />
        <exclude domain="database" path="kolahal.db-wal" />
        <exclude domain="database" path="kolahal.db-shm" />
        <exclude domain="database" path="feeds.db" />
        <exclude domain="database" path="feeds.db-journal" />
        <exclude domain="database" path="feeds.db-wal" />
        <exclude domain="database" path="feeds.db-shm" />
        <exclude domain="sharedpref" path="logs.xml" />
    </device-transfer>
</data-extraction-rules>
