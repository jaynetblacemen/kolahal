---
/**
 * A static mock of the Kolahal home screen: header, a few command blocks with the coloured
 * gutter, suggestion chips and the prompt, always drawn in the app's dark "green" palette.
 */
---

<div class="term" role="img" aria-label="Kolahal home screen: clock header, commands and their output, suggestions and the prompt">
	<div class="term-header">
		<div class="clock"><span class="time">00:14</span><span class="date">Sat 17 Oct</span></div>
		<div class="items">
			<span>unlocks <b>3</b></span>
			<span>bat <b class="ok">82%</b></span>
			<span>net <b>wifi</b></span>
			<span class="gear">⚙︎</span>
		</div>
		<div class="status"><span class="dim">weather ▸</span> Pune: ☀️ +27°C</div>
	</div>

	<div class="term-log">
		<div class="block old">
			<div class="cmd"><span class="p">$</span> = 5 km in mi<span class="ts">00:12</span></div>
			<div class="out">5 km = 3.1069 mi</div>
		</div>
		<div class="block script">
			<div class="out info">── hn · 00:13 ──</div>
			<div class="out"><span class="new">•</span> <span class="link">Show HN: A terminal launcher for Android</span></div>
			<div class="out"><span class="new">•</span> <span class="link">Lua 5.4 in 200 lines</span></div>
		</div>
		<div class="block">
			<div class="cmd"><span class="p">$</span> feed<span class="ts">00:14</span></div>
			<div class="two"><span>#1 Hacker News</span><span class="dim">12/20 unread · every 1h</span></div>
			<div class="two"><span>#2 LWN.net</span><span class="dim">3/40 unread · notify</span></div>
		</div>
		<div class="block">
			<div class="cmd"><span class="p">$</span> open gmail<span class="ts">00:14</span></div>
			<div class="out">launched Gmail</div>
		</div>
	</div>

	<div class="term-chips">
		<span class="chip hl">Maps</span><span class="chip">maps</span><span class="chip">Messages</span><span class="chip">Gmail</span>
	</div>
	<div class="term-prompt"><span class="p">$</span> ma<span class="cursor"></span></div>
</div>

<style>
	/* Always the app's default "green" palette (ui/Theme.kt), whatever the site theme. */
	.term {
		--k-bg: #0b0d0b;
		--k-surface: #151915;
		--k-fg: #d7ded3;
		--k-dim: #7f8a7b;
		--k-prompt: #8fd18a;
		--k-info: #9db8a0;
		--k-link: #7fb8f0;
		--k-script: #b5cea8;
		font-family: var(--sl-font-mono);
		font-size: 0.8rem;
		line-height: 1.45;
		color: var(--k-fg);
		background: var(--k-bg);
		border: 1px solid color-mix(in srgb, var(--k-dim) 35%, transparent);
		border-radius: 1rem;
		padding: 1rem 0.9rem 0.6rem;
		width: min(100%, 24rem);
		margin-inline: auto;
		box-shadow: 0 20px 60px -20px rgb(0 0 0 / 0.6), 0 0 0 6px color-mix(in srgb, var(--k-surface) 70%, transparent);
		text-align: start;
		overflow: hidden;
	}
	.clock {
		display: flex;
		align-items: baseline;
		gap: 0.8rem;
	}
	.time {
		font-size: 1.9rem;
		font-weight: 700;
		letter-spacing: 0.02em;
	}
	.date,
	.dim,
	.ts {
		color: var(--k-dim);
	}
	.items {
		display: flex;
		flex-wrap: wrap;
		gap: 0.2rem 1rem;
		color: var(--k-dim);
		margin-top: 0.35rem;
	}
	.items b {
		color: var(--k-fg);
		font-weight: 700;
	}
	.items b.ok {
		color: var(--k-prompt);
	}
	.gear {
		margin-inline-start: auto;
	}
	.status {
		margin-top: 0.55rem;
		color: var(--k-script);
	}
	.term-log {
		margin-top: 0.8rem;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}
	.block {
		border-inline-start: 2px solid color-mix(in srgb, var(--k-prompt) 55%, transparent);
		padding-inline-start: 0.6rem;
	}
	.block.script {
		border-color: var(--k-script);
	}
	.block.old {
		opacity: 0.55;
	}
	.cmd {
		display: flex;
		gap: 0.5ch;
		font-weight: 600;
	}
	.ts {
		margin-inline-start: auto;
		font-weight: 400;
	}
	.p {
		color: var(--k-prompt);
	}
	.info {
		color: var(--k-info);
	}
	.link {
		color: var(--k-link);
	}
	.new {
		color: var(--k-prompt);
		font-weight: 700;
	}
	.two {
		display: grid;
		grid-template-columns: 1fr 1.3fr;
		gap: 1ch;
	}
	.term-chips {
		display: flex;
		gap: 0.4rem;
		margin-top: 0.9rem;
		overflow: hidden;
	}
	.chip {
		background: var(--k-surface);
		padding: 0.15rem 0.5rem;
		border-radius: 0.3rem;
		white-space: nowrap;
	}
	.chip.hl {
		outline: 1px solid var(--k-prompt);
		color: var(--k-prompt);
	}
	.term-prompt {
		margin-top: 0.5rem;
		padding-top: 0.4rem;
		border-top: 1px solid color-mix(in srgb, var(--k-dim) 25%, transparent);
		font-size: 0.95rem;
	}
	.cursor {
		display: inline-block;
		width: 0.15em;
		height: 1.1em;
		vertical-align: -0.2em;
		margin-inline-start: 1px;
		background: var(--k-prompt);
		animation: blink 1.1s steps(1) infinite;
	}
	@keyframes blink {
		50% {
			opacity: 0;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.cursor {
			animation: none;
		}
	}
</style>
