---
/**
 * Starlight Hero override: same title / tagline / actions as the default, with the fake
 * Kolahal terminal in place of the hero image.
 */
import { LinkButton } from '@astrojs/starlight/components';
import TerminalDemo from './TerminalDemo.astro';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
// Action links are written site-absolute (`/reference/commands/`), like the Markdown links.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (href: string) => (href.startsWith('/') && !href.startsWith('//') ? base + href : href);
---

<div class="hero">
	<div class="demo"><TerminalDemo /></div>
	<div class="stack">
		<div class="copy">
			<p class="kicker">$ kolahal --help</p>
			<h1 id="_top" data-page-title set:html={title} />
			{tagline && <div class="tagline" set:html={tagline} />}
		</div>
		{
			actions.length > 0 && (
				<div class="actions">
					{actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
						<LinkButton href={withBase(href)} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
							{text}
						</LinkButton>
					))}
				</div>
			)
		}
	</div>
</div>

<style>
	.hero {
		display: grid;
		grid-template-columns: 100%;
		align-items: center;
		gap: 2rem;
		padding-block: 1rem 2rem;
	}
	.stack {
		display: flex;
		flex-direction: column;
		gap: 1.75rem;
		text-align: center;
	}
	.copy {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		align-items: center;
	}
	.kicker {
		font-family: var(--sl-font-mono);
		color: var(--sl-color-accent);
		font-size: var(--sl-text-sm);
		margin: 0;
	}
	h1 {
		font-size: clamp(var(--sl-text-3xl), calc(0.25rem + 5vw), var(--sl-text-6xl));
		line-height: var(--sl-line-height-headings);
		font-weight: 700;
		letter-spacing: -0.03em;
		color: var(--sl-color-white);
		margin: 0;
	}
	.tagline {
		font-size: clamp(var(--sl-text-base), calc(0.0625rem + 2vw), var(--sl-text-xl));
		color: var(--sl-color-gray-2);
		max-width: 46ch;
	}
	.actions {
		display: flex;
		gap: 1rem 1.5rem;
		flex-wrap: wrap;
		justify-content: center;
	}
	.demo {
		order: 2;
	}
	@media (min-width: 50rem) {
		.hero {
			grid-template-columns: 6fr 5fr;
			gap: 3rem;
			padding-block: clamp(2.5rem, calc(1rem + 8vmin), 7rem);
		}
		.stack {
			text-align: start;
			order: 1;
		}
		.copy {
			align-items: flex-start;
		}
		.actions {
			justify-content: flex-start;
		}
	}
</style>
