---
/**
 * Every touch gesture on home, drawn on a phone in the app's default "green" palette and
 * numbered; the slot is an ordered list (MDX) naming them in the same order.
 */
---

<figure class="gesture-map">
	<svg viewBox="0 0 240 440" role="img" aria-label="A phone showing where each gesture goes: the header, empty log space, a log line, the prompt and its $, the edge, and a sideways swipe">
		<defs>
			<marker id="gm-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
				<path d="M0 0 L10 5 L0 10 z" class="arrowhead" />
			</marker>
		</defs>
		<rect x="4" y="4" width="232" height="432" rx="30" class="body" />
		<rect x="12" y="12" width="216" height="416" rx="22" class="screen" />

		<!-- header -->
		<text x="26" y="44" class="clock">12:30</text>
		<rect x="88" y="34" width="34" height="6" rx="3" class="faint" />
		<rect x="128" y="34" width="22" height="6" rx="3" class="faint" />
		<rect x="156" y="34" width="26" height="6" rx="3" class="faint" />
		<rect x="26" y="56" width="120" height="5" rx="2.5" class="faint" />
		<line x1="12" y1="74" x2="228" y2="74" class="rule" />

		<!-- log lines -->
		<g class="lines">
			<line x1="22" y1="216" x2="22" y2="242" class="gutter" />
			<rect x="30" y="218" width="96" height="6" rx="3" class="cmd" />
			<rect x="30" y="232" width="132" height="6" rx="3" class="faint" />
			<line x1="22" y1="256" x2="22" y2="300" class="gutter" />
			<rect x="30" y="258" width="80" height="6" rx="3" class="cmd" />
			<rect x="26" y="270" width="176" height="18" rx="4" class="picked" />
			<rect x="30" y="276" width="120" height="6" rx="3" class="faint" />
			<rect x="30" y="294" width="104" height="6" rx="3" class="faint" />
			<line x1="22" y1="314" x2="22" y2="356" class="gutter" />
			<rect x="30" y="316" width="70" height="6" rx="3" class="cmd" />
			<rect x="30" y="330" width="150" height="6" rx="3" class="faint" />
			<rect x="30" y="344" width="90" height="6" rx="3" class="faint" />
		</g>

		<!-- prompt -->
		<line x1="12" y1="388" x2="228" y2="388" class="rule" />
		<text x="24" y="412" class="prompt">$</text>
		<rect x="38" y="402" width="2" height="13" class="caret" />

		<!-- the edge strip -->
		<line x1="223" y1="228" x2="223" y2="372" class="strip" />

		<!-- 1 swipe down on the header -->
		<line x1="196" y1="40" x2="196" y2="66" class="gesture" marker-end="url(#gm-arrow)" />
		<circle cx="196" cy="38" r="5" class="finger" />
		<!-- 2 double-tap empty space -->
		<circle cx="70" cy="132" r="7" class="finger" />
		<circle cx="70" cy="132" r="12" class="ring" />
		<!-- 3 pinch -->
		<line x1="150" y1="162" x2="132" y2="180" class="gesture" marker-end="url(#gm-arrow)" />
		<line x1="170" y1="142" x2="188" y2="124" class="gesture" marker-end="url(#gm-arrow)" />
		<circle cx="150" cy="162" r="5" class="finger" />
		<circle cx="170" cy="142" r="5" class="finger" />
		<!-- 4 swipe sideways -->
		<line x1="64" y1="96" x2="178" y2="96" class="gesture" marker-start="url(#gm-arrow)" marker-end="url(#gm-arrow)" />
		<!-- 5 long-press a line -->
		<circle cx="96" cy="261" r="5" class="finger" />
		<circle cx="96" cy="261" r="10" class="ring" />
		<!-- 6 swipe a line -->
		<line x1="150" y1="279" x2="206" y2="279" class="gesture" marker-end="url(#gm-arrow)" />
		<line x1="130" y1="279" x2="74" y2="279" class="gesture" marker-end="url(#gm-arrow)" />
		<!-- 7 tap the $ -->
		<circle cx="28" cy="407" r="11" class="ring" />
		<!-- 8 swipe up on the prompt -->
		<line x1="130" y1="414" x2="130" y2="394" class="gesture dim" marker-end="url(#gm-arrow)" />
		<circle cx="130" cy="416" r="5" class="finger" />
		<!-- 9 slide along the edge -->
		<line x1="210" y1="300" x2="210" y2="240" class="gesture" marker-start="url(#gm-arrow)" marker-end="url(#gm-arrow)" />

		<!-- numbers -->
		<g class="num">
			<circle cx="174" cy="56" r="8" /><text x="174" y="59">1</text>
			<circle cx="70" cy="158" r="8" /><text x="70" y="161">2</text>
			<circle cx="196" cy="160" r="8" /><text x="196" y="163">3</text>
			<circle cx="120" cy="112" r="8" /><text x="120" y="115">4</text>
			<circle cx="96" cy="244" r="8" /><text x="96" y="247">5</text>
			<circle cx="178" cy="262" r="8" /><text x="178" y="265">6</text>
			<circle cx="54" cy="407" r="8" /><text x="54" y="410">7</text>
			<circle cx="152" cy="404" r="8" /><text x="152" y="407">8</text>
			<circle cx="196" cy="222" r="8" /><text x="196" y="225">9</text>
		</g>
	</svg>
	<div class="legend"><slot /></div>
</figure>

<style>
	.gesture-map {
		--k-bg: #0b0d0b;
		--k-surface: #151915;
		--k-fg: #d7ded3;
		--k-dim: #7f8a7b;
		--k-prompt: #8fd18a;
		--k-work: #f2b35b;
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem 2rem;
		align-items: flex-start;
		margin-block: 1.5rem 2rem;
	}
	svg {
		flex: 0 1 auto;
		width: 100%;
		max-width: 300px;
		height: auto;
	}
	.legend {
		flex: 1 1 16rem;
		min-width: 0;
	}
	.body { fill: #232a22; }
	.screen { fill: var(--k-bg); }
	.rule { stroke: rgba(215, 222, 211, 0.12); stroke-width: 1; }
	.clock { fill: var(--k-fg); font: 700 15px var(--sl-font-mono); }
	.faint { fill: var(--k-dim); opacity: 0.55; }
	.cmd { fill: var(--k-fg); opacity: 0.8; }
	.picked { fill: rgba(143, 209, 138, 0.14); }
	.gutter { stroke: var(--k-prompt); stroke-width: 2; opacity: 0.7; }
	.prompt { fill: var(--k-prompt); font: 700 15px var(--sl-font-mono); }
	.caret { fill: var(--k-prompt); }
	.strip { stroke: var(--k-dim); stroke-width: 4; stroke-linecap: round; }
	.gesture { stroke: var(--k-work); stroke-width: 2; fill: none; }
	.gesture.dim { stroke-dasharray: 3 3; }
	.arrowhead { fill: var(--k-work); }
	.finger { fill: var(--k-work); fill-opacity: 0.35; stroke: var(--k-work); stroke-width: 1.5; }
	.ring { fill: none; stroke: var(--k-work); stroke-width: 1.5; stroke-dasharray: 3 2; }
	.num circle { fill: var(--k-work); stroke: var(--k-bg); stroke-width: 2; }
	.num text { fill: var(--k-bg); font: 700 9px var(--sl-font-mono); text-anchor: middle; }
	.legend :global(ol) {
		list-style: none;
		counter-reset: step;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 0.45rem;
	}
	.legend :global(li) {
		counter-increment: step;
		position: relative;
		padding-left: 2rem;
		margin: 0;
	}
	.legend :global(li)::before {
		content: counter(step);
		position: absolute;
		left: 0;
		top: 0.2rem;
		width: 1.25rem;
		height: 1.25rem;
		border-radius: 50%;
		display: grid;
		place-items: center;
		background: #f2b35b;
		color: #0b0d0b;
		font: 700 0.68rem/1 var(--sl-font-mono);
	}
</style>
