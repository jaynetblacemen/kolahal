---
/**
 * Screenshots side by side, each with a caption under it: the steps of a gesture, in order.
 * One column on a narrow screen.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	items: { src: ImageMetadata; alt: string; caption: string }[];
}

const { items } = Astro.props;
---

<div class="shot-row">
	{
		items.map((it) => (
			<figure>
				<Image src={it.src} alt={it.alt} width={400} />
				<figcaption set:html={it.caption} />
			</figure>
		))
	}
</div>

<style>
	.shot-row {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
		gap: 1.25rem;
		margin-block: 1.5rem;
	}
	figure {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		max-width: 16rem;
	}
	img {
		width: 100%;
		height: auto;
		border-radius: 0.8rem;
		border: 1px solid var(--sl-color-gray-5);
		margin: 0;
	}
	figcaption {
		font-size: var(--sl-text-sm);
		line-height: 1.5;
		color: var(--sl-color-gray-2);
	}
</style>
